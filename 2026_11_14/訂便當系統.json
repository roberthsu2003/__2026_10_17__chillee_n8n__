    {
      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\nconst escapeHtml = v => String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\nconst first = rows[0] || {};\nconst keys = Object.keys(first);\nconst shopKey = keys.find(k => /便當店名稱|商家名稱|店家名稱/.test(k)) || keys[1];\nconst mealKey = keys.find(k => /餐點名稱|品項名稱|餐點/.test(k)) || keys[3];\nconst priceKey = keys.find(k => /價格|單價/.test(k)) || keys[4];\nconst statusKey = keys.find(k => /供應狀態|狀態/.test(k));\nconst available = rows.filter(r => !statusKey || !/暫停|停售|停供/.test(String(r[statusKey] ?? '')));\nconst shops = [...new Set(available.map(r => String(r[shopKey] ?? '')).filter(Boolean))];\nconst mealData = available.map(r => ({shop:String(r[shopKey] ?? ''), meal:String(r[mealKey] ?? ''), price:r[priceKey] ?? ''}));\nconst html = `<!doctype html><html lang=\"zh-Hant\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>訂便當系統</title><style>body{font-family:Arial,sans-serif;max-width:680px;margin:30px auto;padding:20px}label{display:block;margin-top:14px;font-weight:bold}input,select,textarea,button{width:100%;padding:10px;margin-top:6px;box-sizing:border-box;font-size:16px}textarea{min-height:70px}button{margin-top:24px;cursor:pointer}.price{font-size:20px;margin-top:12px;font-weight:bold}</style></head><body><h1>🍱 公司訂便當系統</h1><form method=\"post\" action=\"/webhook/order-lunch-submit\"><label>姓名<input name=\"姓名\" required></label><label>便當店<select name=\"便當店\" id=\"shop\" required><option value=\"\">請選擇便當店</option>${shops.map(s=>`<option value=\"${escapeHtml(s)}\">${escapeHtml(s)}</option>`).join('')}</select></label><label>餐點<select name=\"餐點名稱\" id=\"meal\" required><option value=\"\">請先選擇便當店</option></select></label><div class=\"price\">單價：NT$ <span id=\"price\">0</span></div><input type=\"hidden\" name=\"單價\" id=\"priceInput\"><label>數量<input type=\"number\" name=\"數量\" id=\"qty\" min=\"1\" value=\"1\" required></label><div class=\"price\">總金額：NT$ <span id=\"total\">0</span></div><input type=\"hidden\" name=\"總金額\" id=\"totalInput\"><label>訂購備註<textarea name=\"訂購備註\" placeholder=\"例如：飯少一點、不加香菜\"></textarea><button type=\"submit\">送出訂單</button></form><script>const data=${JSON.stringify(mealData)};const shop=document.getElementById('shop'),meal=document.getElementById('meal'),price=document.getElementById('price'),pi=document.getElementById('priceInput'),qty=document.getElementById('qty'),total=document.getElementById('total'),ti=document.getElementById('totalInput');function updateMeals(){const list=data.filter(x=>x.shop===shop.value);meal.innerHTML='<option value=\"\">請選擇餐點</option>'+list.map(x=>'<option value=\"'+x.meal+'\" data-price=\"'+x.price+'\">'+x.meal+'（NT$ '+x.price+'）</option>').join('');updatePrice()}function updatePrice(){const o=meal.options[meal.selectedIndex];const p=Number(o?.dataset.price||0);price.textContent=p;pi.value=p;const t=p*Number(qty.value||1);total.textContent=t;ti.value=t}shop.addEventListener('change',updateMeals);meal.addEventListener('change',updatePrice);qty.addEventListener('input',updatePrice);</script></body></html>`;\nreturn [{json:{html}}];"
      },
