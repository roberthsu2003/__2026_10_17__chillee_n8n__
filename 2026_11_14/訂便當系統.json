    {
      "parameters": {
        "jsCode": "const b = items[0].json.body || items[0].json;\nconst date = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Taipei' });\nconst store = $getWorkflowStaticData('global');\nif (store.orderDate !== date) { store.orderDate = date; store.orders = []; store.fileId = ''; }\nstore.orders = store.orders || [];\nstore.orders.push({訂購日期:date,姓名:b['姓名']||'',便當店:b['便當店']||'',餐點名稱:b['餐點名稱']||'',單價:b['單價']||'',數量:b['數量']||'',總金額:b['總金額']||'',訂購備註:b['訂購備註']||''});\nconst fileName = `便當訂單_${date}.xlsx`;\nreturn store.orders.map(order => ({json:{...order,檔案名稱:fileName,現有檔案ID:store.fileId||''}}));"
      },
